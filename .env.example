# Copy this file to .env and fill in values for local development
DATABASE_URL=postgresql+asyncpg://promptlab:promptlab@localhost:5432/promptlab
TEST_DATABASE_URL=postgresql+asyncpg://promptlab:promptlab@localhost:5432/promptlab_test

# API key for authentication. Leave empty to disable auth (local dev / testing).
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Docker Compose passes this to both the backend (runtime) and the frontend
# build (as VITE_API_KEY), so this is the only place you need to set it.
API_KEY=
